# StudyPilot AI - Frontend Environment Configuration Example
# Note: In development, requests to /api are proxied via Vite proxy to the FastAPI backend.
VITE_APP_TITLE="StudyPilot AI"
VITE_API_BASE_URL="/api"

# Note: Do NOT expose private API keys (such as Gemini API keys) in frontend environment variables.
# All LLM requests and secret handling must remain on the backend server.
