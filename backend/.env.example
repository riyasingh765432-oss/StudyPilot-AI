# StudyPilot AI - Backend Environment Configuration Example
APP_ENV=development
APP_NAME="StudyPilot AI API"
APP_VERSION=0.3.0
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# SQLite Database
DATABASE_URL="sqlite:///./studypilot.db"

# JWT Authentication
JWT_SECRET_KEY="studypilot-super-secret-development-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API Configuration (Stage 3)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
